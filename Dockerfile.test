FROM python:3.10-slim

COPY --from=ghcr.io/astral-sh/uv:0.12.21 /uv /bin/uv
ENV UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# Set PYTHONPATH to allow imports from src and within src
ENV PYTHONPATH=/app:/app/src PATH="/app/.venv/bin:$PATH"

# Copy and install dependencies
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-install-project

# Copy application code
COPY src ./src
COPY test ./test
COPY pytest.ini .

# Create symlinks for model and data directories to match expected paths
RUN ln -s /app/src/model /app/model && \
    ln -s /app/src/data /app/data

# Default command runs all tests with coverage
CMD ["pytest"]
